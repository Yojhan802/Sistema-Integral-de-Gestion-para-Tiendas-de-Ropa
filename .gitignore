# Secretos y configuración local — nunca se suben al repositorio.
.env
.env.local
*.env.local

# Backend (Maven/Spring Boot)
aplicacion/target/
aplicacion/uploads/
aplicacion/.env
aplicacion/.env.local

# Volcados de la base de datos: contienen datos reales de clientes y hashes de
# contraseñas. Se guardan fuera del repositorio.
backups/
*.sql.gz
*.dump

# Basura de herramientas locales (perfil de navegador de pruebas, logs del GPU).
.browser-profile/
debug.log

# Prompts y notas de trabajo: contexto para desarrollar, no parte del producto.
documento.txt
PROMPT_*.md
prompt-maestro-*.md
prueba.html

# Material de trabajo (logos sueltos, fotos de muestra). Los assets que la
# aplicación sirve viven en front/assets.
recursos/

# Capturas para la landing: pertenecen al proyecto qynex-landing.
sale-*.png
pos-mobile-audit.png

# Editor / SO
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Configuración local de Claude Code — específica de la máquina, no del proyecto.
.claude/settings.local.json

# Artefactos de verificación temporal del frontend (capturas de Playwright)
front/_shot-*.png
front/_debug-*.png

# QR de pago personal con datos reales (nombre, cuenta) — no va a un repo público.
# El logo y demás imágenes de recursos/ sí se versionan.
recursos/Yape QR.jpeg
